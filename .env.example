# 複製成 .env（本機測試用），不要 commit
THREADS_ACCESS_TOKEN=your_long_lived_token_here

# 貼文用的字元集：每次從裡面隨機挑 POST_LENGTH 個字，接上 POST_SUFFIX。
# 放在設定裡而不是程式裡，公開的原始碼就看不出實際發什麼。
POST_CHARS=
POST_LENGTH=3
POST_SUFFIX=

# 想固定發同一句時才填；留空就用上面的隨機組合
# POST_TEXT=

# 貼文底下那則回覆的樣板，留空就不發回覆。可用欄位：
#   {time}          實際發文時刻（HH:MM:SS）
#   {holiday_name}  下一個國定假日的名稱
#   {holiday_days}  距離那個假日還有幾天
# 例如：{time}｜距離{holiday_name}還有{holiday_days}天
REPLY_TEMPLATE=

# 換長效 token 時才需要，到 Meta 後台 App settings > Basic 複製
THREADS_APP_SECRET=

# 平常封殺不讓它出現的排列（不含字尾），逗號分隔可以列多個。
# 留給 PRE_BREAK_TEXT 這種特殊場合專用，讓那個組合平常抽不到。
POST_BANNED=

# 連假前一天（今天上班、明天就是連假第一天）要發的固定內容。
# 留空就跟平常一樣正常抽籤。
PRE_BREAK_TEXT=
